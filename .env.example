# Copier ce fichier en .env.local (développement) et renseigner les mêmes variables sur Vercel.
# En local, si SUPABASE_* sont vides, les réponses sont stockées dans .data/db.json.

# Supabase > Project Settings > API
SUPABASE_URL=
# ⚠️ Clé secrète « service_role » : ne jamais la préfixer par NEXT_PUBLIC_ ni la commiter.
SUPABASE_SERVICE_ROLE_KEY=

# Mot de passe partagé du dashboard /admin (en local, « admin » par défaut)
ADMIN_PASSWORD=
# 32+ caractères aléatoires, ex. : openssl rand -base64 48
ADMIN_SESSION_SECRET=
